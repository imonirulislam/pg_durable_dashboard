# Every setting is read from the environment at startup, so all of these work
# equally as `-e VAR=value` on `docker run`, as `environment:` in compose, or in
# a .env file here for local development. Full table in the README.

# ── Core ──────────────────────────────────────────────────────────────────────

# Optional: a connection that always exists, shown read-only in the UI.
# Connections added through the dashboard are stored separately, so the app
# works with this unset.
#
# Note that a dedicated read-only role does NOT give you a fleet-wide view:
# pg_durable enforces row-level security scoped to submitted_by = current_user,
# so a reader role sees only the instances it started. Only superusers see
# everything. Details in demo/grants.sql.
DATABASE_URL=postgresql://postgres:demo@localhost:5440/postgres

PORT=4000

# Loopback by default: this process holds database credentials, dials whatever
# host a stored connection names, and has no authentication of its own. Only
# widen this behind something that authenticates.
#
# Inside the container this must stay 0.0.0.0 (the image sets it) or nothing can
# reach it — there, the published port is what limits access.
HOST=127.0.0.1

# What the DATABASE_URL connection is called in the UI.
# ENV_CONNECTION_LABEL=DATABASE_URL

# ── Storage and secrets ───────────────────────────────────────────────────────

# Encrypts stored connection passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Left unset, the server generates a key file and warns. Rotating this
# invalidates every saved password.
# APP_SECRET=

# Where the connection store and generated key live. In the image this is /data
# — mount a volume there or saved connections vanish with the container.
# DATA_DIR=data

# Override the individual paths if DATA_DIR isn't granular enough.
# CONNECTIONS_DB=data/connections.db
# APP_SECRET_FILE=data/secret.key

# ── Security ──────────────────────────────────────────────────────────────────

# Allowlist of database hosts the API may connect to. Unset means any host,
# which is fine bound to localhost and not fine once exposed.
# ALLOWED_DB_HOSTS=localhost,db.internal

# CA bundle for sslmode=verify-ca / verify-full when a connection doesn't carry
# its own certificate.
# PGSSLROOTCERT=/etc/ssl/certs/pg-ca.pem

# Cross-origin access, off by default. The single image is same-origin, and in
# development Vite proxies /api server-side, so neither needs this. Set it only
# if you serve the client from a different origin. `*` allows any site and warns.
# CORS_ORIGIN=https://dashboard.example.com

# ── Tuning ────────────────────────────────────────────────────────────────────

# Response cache TTL, in ms. Collapses concurrent identical reads into one
# query; 0 disables it.
# CACHE_TTL_MS=2000

# Per-connection pool and timeouts.
# PG_POOL_MAX=5
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_QUERY_TIMEOUT_MS=15000
# PG_CONNECT_TIMEOUT_MS=5000

# ── Serving ───────────────────────────────────────────────────────────────────

# Where the built client lives. The image sets /app/public; unset in
# development, so port 4000 serves the API only and Vite serves the UI.
# CLIENT_DIR=
